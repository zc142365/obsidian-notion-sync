{
  "name": "obsidian-notion-sync",
  "version": "0.1.0",
  "description": "Obsidian plugin that syncs Markdown notes to Notion.",
  "author": "JongSim",
  "main": "main.js",
  "scripts": {
    "dev": "node esbuild.config.mjs",
    "build": "tsc -noEmit -skipLibCheck && node esbuild.config.mjs production"
  },
  "keywords": [
    "obsidian",
    "notion",
    "sync"
  ],
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^20.11.30",
    "builtin-modules": "^3.3.0",
    "esbuild": "^0.25.0",
    "obsidian": "^1.5.12",
    "tslib": "^2.6.2",
    "typescript": "^5.4.2"
  }
}
